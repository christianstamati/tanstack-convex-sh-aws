{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    // Convex Auth's convex-test helpers ship as TypeScript that imports `.ts` paths.
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
