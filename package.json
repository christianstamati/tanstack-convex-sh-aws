{
  "name": "tanstack-convex-sh-aws",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vite-plus": "1.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/sync-env.ts && vp run --parallel --log labeled --filter './apps/*' --filter './packages/*' dev",
    "build": "vp run --filter './apps/*' build",
    "check": "vp check",
    "test": "vp run --filter './apps/*' --filter './packages/*' test",
    "ready": "vp check && bun run test && bun run build",
    "prepare": "vp config",
    "convex:auth": "bun scripts/auth.ts",
    "convex:local": "bun scripts/convex.ts local",
    "convex:cloud": "bun scripts/convex.ts cloud",
    "convex:which": "bun scripts/convex.ts which",
    "convex:dashboard": "vp run --filter @workspace/backend dashboard",
    "convex:reset": "bun scripts/convex.ts reset",
    "convex:seed": "vp run --no-cache --filter @workspace/backend seed"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.6",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "effect": "4.0.5",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
